---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import { getPosts, postPath, fmtDate, type Post } from '../../../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    const { year, month, day, slug } = postPath(post);
    return { params: { year, month, day, slug }, props: { post } };
  });
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).length / 200));
---
<Base title={post.data.title} description={post.data.description}>
  <article class="post">
    <header class="post-header">
      <a class="back" href="/blog/">← All posts</a>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time> · {minutes} min read
        {post.data.archived && <span class="badge">From the archive</span>}
      </p>
      {post.data.tags.length > 0 && <p class="tags">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</p>}
    </header>
    <div class="prose"><Content /></div>
  </article>
</Base>
